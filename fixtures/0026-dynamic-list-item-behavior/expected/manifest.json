{
  "schema_version": 1,
  "components": [
    {
      "name": "DynamicListItemBehavior",
      "template": {
        "nodes": [
          { "kind": "element", "id": "n0", "tag": "section" },
          { "kind": "element", "id": "n1", "tag": "button" },
          { "kind": "element", "id": "n2", "tag": "p" },
          { "kind": "binding", "id": "n3", "expression": "this.selections", "initial_value": "0" },
          { "kind": "element", "id": "n4", "tag": "ol" },
          {
            "kind": "list",
            "id": "n5",
            "start": "n6",
            "end": "n7",
            "iterable": "this.items",
            "initial_value": [
              { "details": { "region": "west" }, "id": "north", "label": "North" },
              { "details": { "region": "east" }, "id": "south", "label": "South" }
            ],
            "item_variable": "item",
            "index_variable": "index",
            "key_expression": "item.id",
            "item_root": "n8",
            "item_template_html": "<li data-ez-node=\"n8:__ez_list_key__\" title=\"\" data-label=\"\" data-ez-list-bindings=\"title=item.details.region;data-label=item.label\"><button data-ez-node=\"n11:__ez_list_key__\" data-ez-on-click=\"this.select\" data-ez-bindings=\"index,item.label,item.details.region\"><!-- ez-binding:n12:__ez_list_key__:index -->__ez_list_index__<!-- ez-list-binding-end:n12:__ez_list_key__ -->:<!-- ez-binding:n13:__ez_list_key__:item.label --><!-- ez-list-binding-end:n13:__ez_list_key__ -->(<!-- ez-binding:n14:__ez_list_key__:item.details.region --><!-- ez-list-binding-end:n14:__ez_list_key__ -->)</button></li>"
          }
        ],
        "events": [
          { "node": "n1", "event": "click", "handler": "this.refresh" }
        ]
      },
      "actions": [
        {
          "method": "refresh",
          "operation": "assign",
          "field": "items",
          "operand": [
            { "details": { "region": "central" }, "id": "north", "label": "Northern" },
            { "details": { "region": "coastal" }, "id": "east", "label": "East" },
            { "details": { "region": "mountain" }, "id": "south", "label": "Southern" }
          ]
        },
        { "method": "select", "operation": "increment", "field": "selections" }
      ]
    }
  ]
}
