{
  "schema_version": 1,
  "components": [
    {
      "name": "ToggleFlag",
      "template": {
        "nodes": [
          {
            "kind": "element",
            "id": "n0",
            "tag": "button"
          },
          {
            "kind": "binding",
            "id": "n1",
            "expression": "this.enabled",
            "initial_value": false
          }
        ],
        "events": [
          {
            "node": "n0",
            "event": "click",
            "handler": "this.toggle"
          }
        ]
      },
      "actions": [
        {
          "method": "toggle",
          "operation": "toggle",
          "field": "enabled"
        }
      ]
    }
  ]
}
