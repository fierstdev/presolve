{
  "components": [
    {
      "name": "Counter",
      "template": {
        "nodes": [
          {
            "kind": "element",
            "id": "n0",
            "tag": "button"
          },
          {
            "kind": "binding",
            "id": "n1",
            "expression": "this.count",
            "initial_value": "0"
          }
        ],
        "events": [
          {
            "node": "n0",
            "event": "click",
            "handler": "this.increment"
          }
        ]
      },
      "actions": []
    }
  ]
}
