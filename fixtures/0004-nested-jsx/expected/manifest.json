{
  "components": [
    {
      "name": "NestedCounter",
      "template": {
        "nodes": [
          {
            "kind": "element",
            "id": "n0",
            "tag": "section"
          },
          {
            "kind": "element",
            "id": "n1",
            "tag": "button"
          },
          {
            "kind": "binding",
            "id": "n2",
            "expression": "this.count"
          }
        ],
        "events": [
          {
            "node": "n1",
            "handler": "this.increment"
          }
        ]
      }
    }
  ]
}
