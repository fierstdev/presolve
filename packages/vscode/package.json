{
  "name": "presolve-vscode",
  "displayName": "Presolve",
  "version": "0.2.18",
  "description": "Presolve language tooling for Visual Studio Code.",
  "publisher": "fierstdev",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./extension.cjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "presolve",
    "typescript",
    "tsx",
    "compiler"
  ],
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:typescript",
    "workspaceContains:app/index.html"
  ],
  "contributes": {
    "commands": [
      {
        "command": "presolve.status",
        "title": "Presolve: Show Workspace Status"
      },
      {
        "command": "presolve.checkWorkspace",
        "title": "Presolve: Check Workspace",
        "icon": "$(check-all)"
      },
      {
        "command": "presolve.checkActiveFile",
        "title": "Presolve: Check Active File",
        "icon": "$(check)"
      },
      {
        "command": "presolve.explainActiveFile",
        "title": "Presolve: Explain Active File",
        "icon": "$(inspect)"
      },
      {
        "command": "presolve.build",
        "title": "Presolve: Build Production Publication",
        "icon": "$(package)"
      },
      {
        "command": "presolve.doctor",
        "title": "Presolve: Run Doctor",
        "icon": "$(tools)"
      },
      {
        "command": "presolve.openDocs",
        "title": "Presolve: Open Documentation",
        "icon": "$(book)"
      }
    ],
    "configuration": {
      "title": "Presolve",
      "properties": {
        "presolve.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Presolve workspace integration."
        },
        "presolve.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run compiler-owned Presolve diagnostics for a saved TypeScript or TSX source file."
        },
        "presolve.checkOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Run compiler-owned Presolve diagnostics when a TypeScript or TSX source file opens."
        },
        "presolve.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show compiler-derived Presolve component explanation lenses."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "presolve.checkActiveFile",
          "when": "resourceLangId == typescriptreact",
          "group": "navigation@10"
        },
        {
          "command": "presolve.explainActiveFile",
          "when": "resourceLangId == typescriptreact",
          "group": "navigation@11"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fierstdev/presolve.git",
    "directory": "packages/vscode"
  },
  "files": [
    "extension.cjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "test": "node test/workspace-fixture.mjs",
    "package": "npm exec --yes --package=@vscode/vsce@3.9.2 -- vsce package --no-dependencies --pre-release"
  }
}
