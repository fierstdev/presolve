{
  "name": "presolve-vscode",
  "displayName": "Presolve",
  "version": "0.2.4",
  "description": "Presolve language tooling for Visual Studio Code.",
  "publisher": "fierstdev",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./extension.cjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "presolve",
    "typescript",
    "tsx",
    "compiler"
  ],
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:typescript"
  ],
  "contributes": {
    "commands": [
      {
        "command": "presolve.status",
        "title": "Presolve: Show Workspace Status"
      }
    ],
    "configuration": {
      "title": "Presolve",
      "properties": {
        "presolve.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Presolve workspace integration."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fierstdev/presolve.git",
    "directory": "packages/vscode"
  },
  "files": [
    "extension.cjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "test": "node test/workspace-fixture.mjs",
    "package": "npm exec --yes --package=@vscode/vsce@3.9.2 -- vsce package --no-dependencies --pre-release"
  }
}
