{
  "name": "presolve-workspace",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Presolve universal software distribution platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "build:ts": "pnpm --filter @presolve/sdk build",
    "typecheck:ts": "pnpm --filter @presolve/sdk typecheck",
    "test:ts": "pnpm --filter @presolve/sdk test",
    "check:ts": "pnpm --filter @presolve/sdk check",
    "smoke:ts-oci": "./scripts/smoke-typescript-container-oci.sh",
    "smoke:ts-component": "./scripts/smoke-typescript-component.sh",
    "checkpoint:ts": "./scripts/check-typescript-authoring.sh"
  }
}
