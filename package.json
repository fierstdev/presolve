{
  "name": "presolve",
  "version": "0.2.0-beta.24",
  "packageManager": "pnpm@11.17.0",
  "private": true,
  "description": "The Presolve compiler, framework, metaframework, and tooling source repository.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fierstdev/presolve.git"
  },
  "bugs": {
    "url": "https://github.com/fierstdev/presolve/issues"
  },
  "homepage": "https://github.com/fierstdev/presolve#readme",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @presolve/compiler-wasm run build",
    "format": "cargo fmt --all --check",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "check": "pnpm run format && pnpm run lint && pnpm run test && pnpm run docs:check",
    "test": "RUST_TEST_THREADS=1 cargo test --workspace && pnpm run build && pnpm -r test && pnpm run test:types",
    "test:types": "node scripts/test-typescript-compatibility.mjs && tsc -p tests/framework-public-api/tsconfig.json --pretty false",
    "test:scaffold": "node scripts/verify-scaffold.mjs",
    "test:e2e": "cargo test -p presolve-cli --test runtime_browser -- --nocapture --test-threads=1",
    "test:e2e:headed": "cargo test -p presolve-cli --test runtime_browser -- --nocapture --test-threads=1",
    "docs:check": "node scripts/verify-docs.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:check": "./scripts/release-dry-run.sh"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
