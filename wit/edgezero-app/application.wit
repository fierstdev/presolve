package edgezero:app@0.1.0;

/// The minimum application world understood by the initial EdgeZero runtime.
///
/// This world deliberately contains no imported capabilities yet. It exists to
/// establish and verify the component boundary before capabilities are added.
world application {
    /// Execute the application with a UTF-8 input value and return a UTF-8
    /// result.
    export run: func(input: string) -> string;
}
