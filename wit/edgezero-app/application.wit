package edgezero:app@0.1.0;

/// The minimum application world understood by the initial EdgeZero runtime.
///
/// This world deliberately contains no imported capabilities.
world application {
    export run: func(input: string) -> string;
}

/// An EdgeZero application that requires key/value storage.
///
/// This is currently an explicit world used to prove capability binding.
/// Later the EdgeZero build pipeline will derive and validate capability
/// requirements automatically.
world kv-application {
    import edgezero:kv/store@0.1.0;

    export run: func(input: string) -> string;
}
